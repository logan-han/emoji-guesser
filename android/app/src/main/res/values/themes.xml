<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme: used at launch, swapped to main theme by installSplashScreen() -->
    <style name="Theme.EmojiGuesser.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EmojiGuesser</item>
    </style>

    <style name="Theme.EmojiGuesser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
