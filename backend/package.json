{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "deploy": "sls deploy",
    "deploy:prod": "sls deploy --stage prod",
    "remove": "sls remove",
    "logs": "sls logs -f default",
    "info": "sls info",
    "package": "sls package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.8",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "serverless": "^4.17.1",
    "serverless-webpack": "^5.15.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-node-externals": "^3.0.0"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "random-words": "^2.0.1",
    "uuid": "^11.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
